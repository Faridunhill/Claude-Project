# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Mailchimp (https://mailchimp.com/developer/marketing/guides/quick-start/)
MAILCHIMP_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-us1
MAILCHIMP_AUDIENCE_ID=XXXXXXXXXX
MAILCHIMP_SERVER_PREFIX=us1

# Resend — contact form email delivery (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Keystatic CMS — admin dashboard at /keystatic
# Requires a GitHub OAuth App:
#   1. Go to github.com/settings/developers → OAuth Apps → New OAuth App
#   2. Homepage URL: https://faridunhill.com
#   3. Authorization callback URL: https://faridunhill.com/api/keystatic/github/oauth/callback
#   4. Copy Client ID and generate a Client Secret
KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Random 32+ character string for session encryption — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=your_random_secret_here

# ── Encyclopedia Builder (see ENCYCLOPEDIA.md for full setup) ──────────────

# Anthropic — lesson script generation (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs — narration in your cloned voice (https://elevenlabs.io)
#   Create an Instant Voice Clone from ~2 minutes of your recorded speech,
#   then copy the Voice ID from the voice's settings page.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_cloned_voice_id

# HeyGen — presenter video rendering (https://heygen.com)
#   HEYGEN_AVATAR_ID          your styled/cartoon avatar (Avatar IV / studio avatar)
#   HEYGEN_TALKING_PHOTO_ID   avatar built from a photo of your face
#   HEYGEN_VOICE_ID           your voice inside HeyGen (voice clone, or linked ElevenLabs voice)
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_AVATAR_ID=your_avatar_id
HEYGEN_TALKING_PHOTO_ID=your_talking_photo_id
HEYGEN_VOICE_ID=your_heygen_voice_id

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://faridunhill.com
