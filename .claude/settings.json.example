{
  "_comment": "Example only. MERGE these blocks into the PROJECT file .claude/settings.json on the PC. Never copy over an existing settings file, and never touch ~/.claude/settings.json without a backup. Hook commands must need nothing installed - Farid's PC has no jq. Python 3.11 is present.",
  "outputStyle": "Farid Plain",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/capture_decision.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plain_language.py\""
          }
        ]
      }
    ]
  }
}
