{
  "_comment": "Example only. MERGE into the PROJECT file .claude/settings.json on the PC. Never copy over an existing settings file. Back up first. No jq on Farid's PC - Python 3.11 is present. ONE hook command only: capture_decision.py already adds the plain-language rule itself.",
  "outputStyle": "Farid Plain",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/capture_decision.py\""
          }
        ]
      }
    ]
  }
}
